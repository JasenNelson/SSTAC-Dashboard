-      if (requestIdRef.current !== myId) return;
-      const merged = geojsonHit ? [geojsonHit, ...wmsHits] : wmsHits;
-
-      // Remove any prior transient identify popup before opening a new one.
-      if (identifyPopupRef.current) {
