-          map.closePopup(identifyPopupRef.current);
-        } catch {
-          // ignore
-        }
-        identifyPopupRef.current = null;
-      }
-
-      runIdentifyRef.current = null;
-    };
-  }, [interactionMode, isLoaded, leaflet, setIdentifiedFeatures]);
